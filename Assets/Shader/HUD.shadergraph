{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "aba0c5991e254203b0d41b9e99886f5f",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "LayeredSoulWave (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 860.0,
            "y": 65.0,
            "width": 220.0,
            "height": 245.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "7555ac267ed6490b8c9868b88267c2b8"
        },
        {
            "m_Id": "3689907e176a4ec1b8dc43d5f858055c"
        },
        {
            "m_Id": "86057330825b4575bfc46fe1e8c0723f"
        },
        {
            "m_Id": "f2473fe98a67468387d1f87b41a41718"
        },
        {
            "m_Id": "f6858c2070474f989ebc51556d066e69"
        },
        {
            "m_Id": "f203cd909e0b41708b5a0ba31612840e"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "LayeredSoulWave",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float x = UV.x - 0.5;\nfloat amount = saturate(min(Fill, 1.0 - Fill) * 18.0);\nfloat front = Fill + amount * 0.027 * sin(x * 8.5 + Phase) - UV.y;\nfloat back = Fill + amount * (0.014 + 0.023 * sin(x * 7.3 + Phase * 0.82 + 1.2)) - UV.y;\n\nfloat frontWidth = max(fwidth(front) * 0.65, 0.0001);\nfloat backWidth = max(fwidth(back) * 0.65, 0.0001);\nfloat body = smoothstep(-frontWidth, frontWidth, front);\nfloat backLayer = 0.42 * smoothstep(-backWidth, backWidth, back) * (1.0 - body);\nfloat rim = 1.0 - smoothstep(0.009, 0.025, front);\nfloat3 bodyColor = lerp(TextureColor, float3(1.0, 0.99, 1.0), rim * 0.38);\n\nCoverage = body + backLayer;\nColor = (bodyColor * body + float3(0.58, 0.67, 0.86) * backLayer) / max(Coverage, 0.0001);\n\nif (Fill <= 0.0 || Fill >= 1.0)\n{\n    Coverage = step(1.0, Fill);\n    Color = TextureColor;\n}"
}

