using System.Collections;
using TMPro;
using UnityEngine;
using UnityEngine.InputSystem;

public sealed class DirtmouthTown : MonoBehaviour
{
    public PlayerController player;
    public Transform bench;
    public TMP_Text prompt;
    public CanvasGroup title;
    private bool resting, leaving;
    private float restTimer;
    private InputAction interact;
    private string currentUpKey;

    private void Start()
    {
        interact = new InputAction("Town interaction", InputActionType.Button);
        BindInteraction();
        GameOptions.Changed += BindInteraction;
        if (title != null) StartCoroutine(ShowTitle());
    }
    private void BindInteraction()
    {
        string key = GameOptions.Key(2);
        if (currentUpKey == key) return;
        currentUpKey = key;
        interact.Disable();
        while (interact.bindings.Count > 0) interact.ChangeBinding(0).Erase();
        interact.AddBinding("<Keyboard>/" + key);
        interact.AddBinding("<Gamepad>/dpad/up");
        interact.AddBinding("<Gamepad>/leftStick/up");
        interact.Enable();
    }
    private IEnumerator ShowTitle()
    {
        float elapsed = 0f;
        while (elapsed < 6f)
        {
            elapsed += Time.deltaTime;
            title.alpha = Mathf.Min(Mathf.Clamp01((elapsed - 0.6f) / 1.2f), Mathf.Clamp01((6f - elapsed) / 1.2f));
            yield return null;
        }
        title.alpha = 0f;
    }
    private void Update()
    {
        if (player == null || leaving) return;
        if (resting)
        {
            resting = player.IsResting;
        }
        bool atBench = bench != null && Mathf.Abs(player.transform.position.x - bench.position.x) < 2f && player.IsGrounded;
        if (prompt != null)
        {
            if (bench != null && Camera.main != null)
                prompt.rectTransform.position = Camera.main.WorldToScreenPoint(bench.position + Vector3.up * 2.8f);
            prompt.gameObject.SetActive(atBench || resting);
            prompt.text = resting ? (GameOptions.Chinese ? "已恢复体力" : "Rested") :
                (GameOptions.Chinese ? "休息" : "REST") + "  ·  " + GameOptions.Key(2).ToUpperInvariant();
        }
        if (!resting && atBench && interact.WasPressedThisFrame()) Rest();
        // The well opening is genuinely traversable; the existing Game scene is the destination below it.
        if (player.transform.position.y < -5f && Mathf.Abs(player.transform.position.x - 18f) < 3.5f)
            EnterWell();
        else if (player.transform.position.y < -15f)
            player.transform.position = new Vector3(-3.5f, 1.3f);
    }
    public void Rest()
    {
        if (player == null || resting || player.IsResting) return;
        player.GetComponent<KnightAudio>()?.Rest();
        player.GetComponent<PlayerHealth>()?.Heal(99);
        player.GetComponent<PlayerUI>()?.RestoreHealth();
        var body = player.GetComponent<Rigidbody2D>();
        body.linearVelocity = Vector2.zero;
        SaveGameManager.Instance.SaveCurrentGame();
        player.RestOnBench(bench);
        resting = player.IsResting;
    }
    public void EnterWell()
    {
        if (leaving) return;
        leaving = SaveGameManager.Instance.TravelToScene("Assets/Scenes/Game.unity");
    }
    private void OnDestroy()
    {
        GameOptions.Changed -= BindInteraction;
        interact?.Dispose();
    }
}
